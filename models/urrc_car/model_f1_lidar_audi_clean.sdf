    <link name="rear_right_wheel">
      <pose>-0.165 -0.095 -0.075 -1.5707963 0 0</pose>
      <inertial>
        <mass>0.13</mass>
        <inertia>
          <ixx>0.00013</ixx>
          <iyy>0.00013</iyy>
