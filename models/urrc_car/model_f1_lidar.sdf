<?xml version="1.0"?>
<sdf version="1.10">
<model name="urrc_car">

  <static>false</static>
  <self_collide>false</self_collide>

  <!-- =========================
       CHASSIS / MAIN BODY
       +X = front
       ========================= -->
  <link name="chassis">

    <inertial>
      <mass>3.2</mass>
      <inertia>
        <ixx>0.018</ixx>
        <iyy>0.070</iyy>
        <izz>0.080</izz>
      </inertia>
    </inertial>

    <!-- 물리는 단순하게 -->
    <collision name="main_collision">
      <pose>0 0 -0.030 0 0 0</pose>
      <geometry>
        <box>
          <size>0.46 0.14 0.06</size>
        </box>
      </geometry>
    </collision>

    <!-- 바닥 플로어 -->
    <visual name="floor">
      <pose>0 0 -0.055 0 0 0</pose>
      <geometry>
        <box>
          <size>0.52 0.20 0.01</size>
        </box>
      </geometry>
      <material>
        <ambient>0.05 0.05 0.05 1</ambient>
        <diffuse>0.05 0.05 0.05 1</diffuse>
      </material>
    </visual>

    <!-- 메인 모노코크 -->
    <visual name="monocoque">
      <pose>-0.02 0 -0.005 0 0 0</pose>
      <geometry>
        <box>
          <size>0.28 0.08 0.06</size>
        </box>
      </geometry>
      <material>
        <ambient>0.08 0.10 0.35 1</ambient>
        <diffuse>0.08 0.10 0.35 1</diffuse>
      </material>
    </visual>

    <!-- 노즈 뒤쪽 -->
    <visual name="nose_base">
      <pose>0.11 0 -0.010 0 0 0</pose>
      <geometry>
        <box>
          <size>0.18 0.055 0.040</size>
        </box>
      </geometry>
      <material>
        <ambient>0.08 0.10 0.35 1</ambient>
        <diffuse>0.08 0.10 0.35 1</diffuse>
      </material>
    </visual>

    <!-- 노즈 앞쪽 -->
    <visual name="nose_tip">
      <pose>0.22 0 -0.015 0 0 0</pose>
      <geometry>
        <box>
          <size>0.08 0.045 0.030</size>
        </box>
      </geometry>
      <material>
        <ambient>0.90 0.80 0.10 1</ambient>
        <diffuse>0.90 0.80 0.10 1</diffuse>
      </material>
    </visual>

    <!-- 좌측 사이드포드 -->
    <visual name="left_sidepod">
      <pose>-0.07 0.070 -0.005 0 0 0</pose>
      <geometry>
        <box>
          <size>0.22 0.05 0.05</size>
        </box>
      </geometry>
      <material>
        <ambient>0.08 0.10 0.35 1</ambient>
        <diffuse>0.08 0.10 0.35 1</diffuse>
      </material>
    </visual>

    <!-- 우측 사이드포드 -->
    <visual name="right_sidepod">
      <pose>-0.07 -0.070 -0.005 0 0 0</pose>
      <geometry>
        <box>
          <size>0.22 0.05 0.05</size>
        </box>
      </geometry>
      <material>
        <ambient>0.08 0.10 0.35 1</ambient>
        <diffuse>0.08 0.10 0.35 1</diffuse>
      </material>
    </visual>

    <!-- 엔진 커버 -->
    <visual name="engine_cover">
      <pose>-0.16 0 0.020 0 0 0</pose>
      <geometry>
        <box>
          <size>0.18 0.09 0.06</size>
        </box>
      </geometry>
      <material>
        <ambient>0.08 0.10 0.35 1</ambient>
        <diffuse>0.08 0.10 0.35 1</diffuse>
      </material>
    </visual>

    <!-- 콕핏 -->
    <visual name="cockpit">
      <pose>-0.015 0 0.020 0 0 0</pose>
      <geometry>
        <box>
          <size>0.08 0.06 0.03</size>
        </box>
      </geometry>
      <material>
        <ambient>0.03 0.03 0.03 1</ambient>
        <diffuse>0.03 0.03 0.03 1</diffuse>
      </material>
    </visual>

    <!-- 롤후프 -->
    <visual name="roll_hoop">
      <pose>-0.050 0 0.040 0 0 0</pose>
      <geometry>
        <box>
          <size>0.02 0.06 0.04</size>
        </box>
      </geometry>
      <material>
        <ambient>0.95 0.75 0.10 1</ambient>
        <diffuse>0.95 0.75 0.10 1</diffuse>
      </material>
    </visual>

    <!-- 에어박스 -->
    <visual name="airbox">
      <pose>-0.12 0 0.035 0 1.5707963 0</pose>
      <geometry>
        <cylinder>
          <radius>0.020</radius>
          <length>0.12</length>
        </cylinder>
      </geometry>
      <material>
        <ambient>0.08 0.08 0.08 1</ambient>
        <diffuse>0.08 0.08 0.08 1</diffuse>
      </material>
    </visual>

    <!-- 프론트 윙 메인 플레인 -->
    <visual name="front_wing_main">
      <pose>0.245 0 -0.050 0 0 0</pose>
      <geometry>
        <box>
          <size>0.05 0.21 0.01</size>
        </box>
      </geometry>
      <material>
        <ambient>0.02 0.02 0.02 1</ambient>
        <diffuse>0.02 0.02 0.02 1</diffuse>
      </material>
    </visual>

    <!-- 프론트 윙 상단 -->
    <visual name="front_wing_upper">
      <pose>0.235 0 -0.035 0 0 0</pose>
      <geometry>
        <box>
          <size>0.04 0.18 0.008</size>
        </box>
      </geometry>
      <material>
        <ambient>0.90 0.90 0.90 1</ambient>
        <diffuse>0.90 0.90 0.90 1</diffuse>
      </material>
    </visual>

    <!-- 프론트 윙 좌측 엔드플레이트 -->
    <visual name="front_wing_left_endplate">
      <pose>0.245 0.105 -0.040 0 0 0</pose>
      <geometry>
        <box>
          <size>0.01 0.01 0.05</size>
        </box>
      </geometry>
      <material>
        <ambient>0.95 0.95 0.95 1</ambient>
        <diffuse>0.95 0.95 0.95 1</diffuse>
      </material>
    </visual>

    <!-- 프론트 윙 우측 엔드플레이트 -->
    <visual name="front_wing_right_endplate">
      <pose>0.245 -0.105 -0.040 0 0 0</pose>
      <geometry>
        <box>
          <size>0.01 0.01 0.05</size>
        </box>
      </geometry>
      <material>
        <ambient>0.95 0.95 0.95 1</ambient>
        <diffuse>0.95 0.95 0.95 1</diffuse>
      </material>
    </visual>

    <!-- 리어 윙 메인 -->
    <visual name="rear_wing_main">
      <pose>-0.245 0 0.030 0 0 0</pose>
      <geometry>
        <box>
          <size>0.02 0.18 0.04</size>
        </box>
      </geometry>
      <material>
        <ambient>0.02 0.02 0.02 1</ambient>
        <diffuse>0.02 0.02 0.02 1</diffuse>
      </material>
    </visual>

    <!-- 리어 윙 상단 -->
    <visual name="rear_wing_upper">
      <pose>-0.245 0 0.055 0 0 0</pose>
      <geometry>
        <box>
          <size>0.02 0.18 0.010</size>
        </box>
      </geometry>
      <material>
        <ambient>0.90 0.90 0.90 1</ambient>
        <diffuse>0.90 0.90 0.90 1</diffuse>
      </material>
    </visual>

    <!-- 리어 윙 좌측 엔드플레이트 -->
    <visual name="rear_wing_left_endplate">
      <pose>-0.245 0.090 0.030 0 0 0</pose>
      <geometry>
        <box>
          <size>0.01 0.01 0.06</size>
        </box>
      </geometry>
      <material>
        <ambient>0.90 0.90 0.90 1</ambient>
        <diffuse>0.90 0.90 0.90 1</diffuse>
      </material>
    </visual>

    <!-- 리어 윙 우측 엔드플레이트 -->
    <visual name="rear_wing_right_endplate">
      <pose>-0.245 -0.090 0.030 0 0 0</pose>
      <geometry>
        <box>
          <size>0.01 0.01 0.06</size>
        </box>
      </geometry>
      <material>
        <ambient>0.90 0.90 0.90 1</ambient>
        <diffuse>0.90 0.90 0.90 1</diffuse>
      </material>
    </visual>

  </link>

  <!-- =========================
       FRONT STEERING LINKS
       ========================= -->
  <link name="front_left_steering_link">
    <pose>0.165 0.095 -0.075 0 0 0</pose>
    <inertial>
      <mass>0.05</mass>
      <inertia>
        <ixx>0.0001</ixx>
        <iyy>0.0001</iyy>
        <izz>0.0001</izz>
      </inertia>
    </inertial>
  </link>

  <link name="front_right_steering_link">
    <pose>0.165 -0.095 -0.075 0 0 0</pose>
    <inertial>
      <mass>0.05</mass>
      <inertia>
        <ixx>0.0001</ixx>
        <iyy>0.0001</iyy>
        <izz>0.0001</izz>
      </inertia>
    </inertial>
  </link>

  <!-- =========================
       WHEELS
       ========================= -->
  <link name="front_left_wheel">
    <pose>0.165 0.095 -0.075 -1.5707963 0 0</pose>
    <inertial>
      <mass>0.13</mass>
      <inertia>
        <ixx>0.00013</ixx>
        <iyy>0.00013</iyy>
        <izz>0.00007</izz>
      </inertia>
    </inertial>
    <collision name="collision">
      <geometry>
        <cylinder>
          <radius>0.045</radius>
          <length>0.025</length>
        </cylinder>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>1.2</mu>
            <mu2>1.2</mu2>
            <fdir1>0 0 1</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
    <visual name="visual">
      <geometry>
        <cylinder>
          <radius>0.045</radius>
          <length>0.025</length>
        </cylinder>
      </geometry>
      <material>
        <ambient>0.05 0.05 0.05 1</ambient>
        <diffuse>0.05 0.05 0.05 1</diffuse>
      </material>
    </visual>
  </link>

  <link name="front_right_wheel">
    <pose>0.165 -0.095 -0.075 -1.5707963 0 0</pose>
    <inertial>
      <mass>0.13</mass>
      <inertia>
        <ixx>0.00013</ixx>
        <iyy>0.00013</iyy>
        <izz>0.00007</izz>
      </inertia>
    </inertial>
    <collision name="collision">
      <geometry>
        <cylinder>
          <radius>0.045</radius>
          <length>0.025</length>
        </cylinder>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>1.2</mu>
            <mu2>1.2</mu2>
            <fdir1>0 0 1</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
    <visual name="visual">
      <geometry>
        <cylinder>
          <radius>0.045</radius>
          <length>0.025</length>
        </cylinder>
      </geometry>
      <material>
        <ambient>0.05 0.05 0.05 1</ambient>
        <diffuse>0.05 0.05 0.05 1</diffuse>
      </material>
    </visual>
  </link>

  <link name="rear_left_wheel">
    <pose>-0.165 0.095 -0.075 -1.5707963 0 0</pose>
    <inertial>
      <mass>0.13</mass>
      <inertia>
        <ixx>0.00013</ixx>
        <iyy>0.00013</iyy>
        <izz>0.00007</izz>
      </inertia>
    </inertial>
    <collision name="collision">
      <geometry>
        <cylinder>
          <radius>0.045</radius>
          <length>0.025</length>
        </cylinder>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>1.2</mu>
            <mu2>1.2</mu2>
            <fdir1>0 0 1</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
    <visual name="visual">
      <geometry>
        <cylinder>
          <radius>0.045</radius>
          <length>0.025</length>
        </cylinder>
      </geometry>
      <material>
        <ambient>0.05 0.05 0.05 1</ambient>
        <diffuse>0.05 0.05 0.05 1</diffuse>
      </material>
    </visual>
  </link>

  <link name="rear_right_wheel">
    <pose>-0.165 -0.095 -0.075 -1.5707963 0 0</pose>
    <inertial>
      <mass>0.13</mass>
      <inertia>
        <ixx>0.00013</ixx>
        <iyy>0.00013</iyy>
        <izz>0.00007</izz>
      </inertia>
    </inertial>
    <collision name="collision">
      <geometry>
        <cylinder>
          <radius>0.045</radius>
          <length>0.025</length>
        </cylinder>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>1.2</mu>
            <mu2>1.2</mu2>
            <fdir1>0 0 1</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
    <visual name="visual">
      <geometry>
        <cylinder>
          <radius>0.045</radius>
          <length>0.025</length>
        </cylinder>
      </geometry>
      <material>
        <ambient>0.05 0.05 0.05 1</ambient>
        <diffuse>0.05 0.05 0.05 1</diffuse>
      </material>
    </visual>
  </link>

  <!-- =========================
       JOINTS
       ========================= -->
  <joint name="front_left_steering_joint" type="revolute">
    <parent>chassis</parent>
    <child>front_left_steering_link</child>
    <axis>
      <xyz>0 0 1</xyz>
      <limit>
        <lower>-0.610865</lower>
        <upper>0.610865</upper>
        <velocity>2.0</velocity>
        <effort>20</effort>
      </limit>
    </axis>
  </joint>

  <joint name="front_right_steering_joint" type="revolute">
    <parent>chassis</parent>
    <child>front_right_steering_link</child>
    <axis>
      <xyz>0 0 1</xyz>
      <limit>
        <lower>-0.610865</lower>
        <upper>0.610865</upper>
        <velocity>2.0</velocity>
        <effort>20</effort>
      </limit>
    </axis>
  </joint>

  <joint name="front_left_wheel_joint" type="revolute">
    <parent>front_left_steering_link</parent>
    <child>front_left_wheel</child>
    <axis>
      <xyz>0 0 1</xyz>
      <limit>
        <lower>-1.79769e+308</lower>
        <upper>1.79769e+308</upper>
      </limit>
    </axis>
  </joint>

  <joint name="front_right_wheel_joint" type="revolute">
    <parent>front_right_steering_link</parent>
    <child>front_right_wheel</child>
    <axis>
      <xyz>0 0 1</xyz>
      <limit>
        <lower>-1.79769e+308</lower>
        <upper>1.79769e+308</upper>
      </limit>
    </axis>
  </joint>

  <joint name="rear_left_wheel_joint" type="revolute">
    <parent>chassis</parent>
    <child>rear_left_wheel</child>
    <axis>
      <xyz>0 0 1</xyz>
      <limit>
        <lower>-1.79769e+308</lower>
        <upper>1.79769e+308</upper>
      </limit>
    </axis>
  </joint>

  <joint name="rear_right_wheel_joint" type="revolute">
    <parent>chassis</parent>
    <child>rear_right_wheel</child>
    <axis>
      <xyz>0 0 1</xyz>
      <limit>
        <lower>-1.79769e+308</lower>
        <upper>1.79769e+308</upper>
      </limit>
    </axis>
  </joint>


  <!-- =========================
       2D LiDAR
       front center
       ========================= -->

  <link name="lidar_link">
    <pose>0.272 0 -0.040 0 0 0</pose>

    <inertial>
      <mass>0.02</mass>
      <inertia>
        <ixx>0.00001</ixx>
        <iyy>0.00001</iyy>
        <izz>0.00001</izz>
      </inertia>
    </inertial>

    <visual name="lidar_visual">
      <geometry>
        <cylinder>
          <radius>0.018</radius>
          <length>0.015</length>
        </cylinder>
      </geometry>

      <material>
        <ambient>0.08 0.08 0.08 1</ambient>
        <diffuse>0.08 0.08 0.08 1</diffuse>
      </material>
    </visual>

    <sensor name="race_lidar" type="gpu_lidar">

      <topic>/scan</topic>

      <update_rate>20</update_rate>

      <always_on>true</always_on>

      <visualize>true</visualize>

      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>

            <!-- 전방 기준 270도 -->
            <min_angle>-1.570796</min_angle>
            <max_angle>1.570796</max_angle>

          </horizontal>
        </scan>

        <range>
          <min>0.05</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>

      </lidar>

    </sensor>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent>chassis</parent>
    <child>lidar_link</child>
  </joint>

  <!-- =========================
       ACKERMANN
       ========================= -->
  <plugin
    filename="gz-sim-ackermann-steering-system"
    name="gz::sim::systems::AckermannSteering">

    <left_joint>rear_left_wheel_joint</left_joint>
    <right_joint>rear_right_wheel_joint</right_joint>

    <left_steering_joint>front_left_steering_joint</left_steering_joint>
    <right_steering_joint>front_right_steering_joint</right_steering_joint>

    <wheel_base>0.330</wheel_base>
    <wheel_separation>0.190</wheel_separation>
    <kingpin_width>0.190</kingpin_width>
    <wheel_radius>0.045</wheel_radius>

    <steering_limit>0.610865</steering_limit>

    <min_velocity>-1.5</min_velocity>
    <max_velocity>3.0</max_velocity>

    <min_acceleration>-4.0</min_acceleration>
    <max_acceleration>4.0</max_acceleration>

    <steer_p_gain>10.0</steer_p_gain>
    <odom_publish_frequency>50</odom_publish_frequency>
  </plugin>

</model>
</sdf>
